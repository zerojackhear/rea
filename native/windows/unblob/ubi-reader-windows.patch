+"""Strict UBI mapping; damaged or absent LEBs are not invented as erased data.
+SPDX-License-Identifier: GPL-3.0-or-later
+"""
+from collections import Counter, defaultdict
+from dataclasses import dataclass
+import zlib
+
+from ubireader.ubi import headers
+from ubireader.ubi import defines as d
+
+
+def guess_peb_size(source):
+    original = source.tell()
+    positions = []
+    attempts = 0
+    try:
+        source.seek(0)
+        offset = 0
+        prefix = b""
+        while True:
+            part = source.read(65536)
+            if not part:
+                break
+            resume = source.tell()
+            data = prefix + part
+            index = data.find(d.UBI_EC_HDR_MAGIC)
+            while index != -1:
+                attempts += 1
+                if attempts > 100_000:
+                    raise ValueError("UBI header search exceeds its 100000-candidate bound")
+                position = offset - len(prefix) + index
+                source.seek(position)
+                raw = source.read(d.UBI_EC_HDR_SZ)
+                if len(raw) == d.UBI_EC_HDR_SZ:
+                    ec = headers.ec_hdr(raw)
+                    if not ec.errors and ec.version == 1 and ec.vid_hdr_offset >= 64 and ec.data_offset >= ec.vid_hdr_offset + 64:
+                        positions.append(position)
+                index = data.find(d.UBI_EC_HDR_MAGIC, index + 1)
+            source.seek(resume)
+            offset += len(part)
+            prefix = data[-3:]
+        if len(positions) < 2 or positions[0] != 0:
+            raise ValueError("UBI physical erase-block size cannot be established from valid headers")
+        intervals = Counter(b - a for a, b in zip(positions, positions[1:]))
+        return intervals.most_common(1)[0][0]
+    finally:
+        source.seek(original)
+
+
+@dataclass
+class Block:
+    vid: object
+    position: int
+    length: int
+    source_peb: int
+
+
+@dataclass
+class Volume:
+    number: int
+    table: object
+    blocks: list
+
+
+def read_volumes(source, size):
+    peb = guess_peb_size(source)
+    if peb < 128 or size % peb:
+        raise ValueError("UBI input does not contain whole physical erase blocks")
+    blocks = defaultdict(dict)
+    sequences = set()
+    for offset in range(0, size, peb):
+        source.seek(offset)
+        ec = headers.ec_hdr(source.read(d.UBI_EC_HDR_SZ))
+        if ec.magic != d.UBI_EC_HDR_MAGIC or ec.version != 1 or ec.errors:
+            raise ValueError(f"UBI erase-count header CRC or identity mismatch at offset {offset}")
+        if not 64 <= ec.vid_hdr_offset <= ec.data_offset - 64 or ec.data_offset >= peb:
+            raise ValueError("UBI header/data offsets cross the physical erase block")
+        sequences.add(ec.image_seq)
+        if len(sequences) > 1:
+            raise ValueError("UBI image sequence identities disagree")
+        source.seek(offset + ec.vid_hdr_offset)
+        raw = source.read(d.UBI_VID_HDR_SZ)
+        if raw == b"\xff" * d.UBI_VID_HDR_SZ:
+            continue
+        vid = headers.vid_hdr(raw)
+        if vid.magic != d.UBI_VID_HDR_MAGIC or vid.version != 1 or vid.errors:
+            raise ValueError(f"UBI volume header CRC or identity mismatch at offset {offset}")
+        if vid.vol_type not in (1, 2) or vid.copy_flag not in (0, 1) or vid.data_pad >= peb - ec.data_offset:
+            raise ValueError("UBI volume header has invalid type, copy flag or data padding")
+        available = peb - ec.data_offset - vid.data_pad
+        if vid.vol_type == d.UBI_VID_STATIC or vid.copy_flag:
+            if not 0 < vid.data_size <= available:
+                raise ValueError("UBI copied/static block length exceeds its extent")
+            source.seek(offset + ec.data_offset)
+            if (~zlib.crc32(source.read(vid.data_size)) & 0xffffffff) != vid.data_crc:
+                raise ValueError("UBI static/copied data CRC mismatch")
+        elif vid.data_size or vid.used_ebs or vid.data_crc:
+            raise ValueError("UBI dynamic block has unexplained static-data metadata")
+        length = vid.data_size if vid.vol_type == d.UBI_VID_STATIC else available
+        block = Block(vid, offset + ec.data_offset, length, offset // peb)
+        previous = blocks[vid.vol_id].get(vid.lnum)
+        if previous is not None and previous.vid.sqnum == vid.sqnum:
+            source.seek(previous.position); old = source.read(previous.length)
+            source.seek(block.position); new = source.read(block.length)
+            if old != new or previous.vid.__dict__ != vid.__dict__:
+                raise ValueError("Conflicting UBI blocks share a sequence and logical identity")
+        if previous is None or previous.vid.sqnum < vid.sqnum:
+            blocks[vid.vol_id][vid.lnum] = block
+    layouts = blocks.pop(d.UBI_INTERNAL_VOL_START, None)
+    if layouts is None or set(layouts) != {0, 1}:
+        raise ValueError("UBI volume-table copies are incomplete")
+    tables = []
+    for index in (0, 1):
+        block = layouts[index]
+        if block.length < d.UBI_MAX_VOLUMES * d.UBI_VTBL_REC_SZ:
+            raise ValueError("UBI volume table is truncated")
+        source.seek(block.position)
+        raw = source.read(d.UBI_MAX_VOLUMES * d.UBI_VTBL_REC_SZ)
+        table = []
+        for number in range(d.UBI_MAX_VOLUMES):
+            record = headers._vtbl_rec(raw[number * d.UBI_VTBL_REC_SZ:(number + 1) * d.UBI_VTBL_REC_SZ])
+            if record.errors:
+                raise ValueError("UBI volume-table record CRC mismatch")
+            table.append(record)
+        tables.append((raw, table))
+    if tables[0][0] != tables[1][0]:
+        raise ValueError("UBI volume-table copies disagree")
+    result = []
+    for number, table in enumerate(tables[0][1]):
+        if table.reserved_pebs == 0:
+            if number in blocks:
+                raise ValueError("UBI blocks refer to an unallocated volume")
+            continue
+        if table.upd_marker or table.vol_type not in (1, 2) or not 0 < table.name_len <= 127 or table.alignment == 0:
+            raise ValueError("UBI volume has incomplete update or invalid table metadata")
+        candidates = blocks.pop(number, {})
+        ordered = sorted(candidates.items())
+        if not ordered:
+            raise ValueError("UBI volume has no observed data blocks; its content is unknown")
+        if ordered[-1][0] >= table.reserved_pebs or any(index != lnum for index, (lnum, _) in enumerate(ordered)):
+            raise ValueError("UBI logical block is absent or outside the volume; no erased-byte repair was applied")
+        for _, block in ordered:
+            if block.vid.vol_type != table.vol_type or block.vid.data_pad != table.data_pad:
+                raise ValueError("UBI block type or padding disagrees with its volume table")
+            if table.vol_type == d.UBI_VID_STATIC and block.vid.used_ebs != len(ordered):
+                raise ValueError("UBI static volume has missing declared logical blocks")
+        result.append(Volume(number, table, [block for _, block in ordered]))
+    if blocks:
+        raise ValueError("UBI contains unrecognized internal or unlisted volume identities")
+    return peb, sequences.pop(), result
