+"""Strict, read-only UBIFS committed-index reader.
+
+Uses ubi-reader's format structures. Does not replay a dirty journal, create
+files or replace damaged data. Caller owns output and reports coverage notes.
+SPDX-License-Identifier: GPL-3.0-or-later
+"""
+from collections import defaultdict
+from dataclasses import dataclass
+import struct
+import zlib
+
+from ubireader.ubifs import nodes
+from ubireader.ubifs import defines as d
+
+
+def read_node(source, position, boundary, expected_length=None):
+    if position < 0 or boundary - position < d.UBIFS_COMMON_HDR_SZ:
+        raise ValueError("UBIFS node address is outside its logical erase block")
+    source.seek(position)
+    header = nodes.common_hdr(source.read(d.UBIFS_COMMON_HDR_SZ))
+    if header.magic != int.from_bytes(d.UBIFS_NODE_MAGIC, "little"):
+        raise ValueError(f"UBIFS node magic mismatch at offset {position}")
+    if not d.UBIFS_COMMON_HDR_SZ <= header.len <= boundary - position:
+        raise ValueError("UBIFS node extent crosses its logical erase block")
+    if expected_length is not None and header.len != expected_length:
+        raise ValueError("UBIFS index length disagrees with its referenced node")
+    if header.group_type not in (0, 1, 2) or header.padding != bytes(2):
+        raise ValueError("UBIFS common header contains unknown flags or padding")
+    body = source.read(header.len - d.UBIFS_COMMON_HDR_SZ)
+    if len(body) != header.len - d.UBIFS_COMMON_HDR_SZ:
+        raise EOFError("Truncated UBIFS node")
+    # Kernel UBIFS CRC covers sqnum through the end, with initial 0xffffffff.
+    prefix = struct.pack("<QIBB2s", header.sqnum, header.len, header.node_type,
+                         header.group_type, header.padding)
+    if (~zlib.crc32(prefix + body) & 0xffffffff) != header.crc:
+        raise ValueError(f"UBIFS node CRC mismatch at offset {position}")
+    return header, body
+
+
+@dataclass
+class DataBlock:
+    node: object
+    encoded: bytes
+
+
+class CommittedTree:
+    def __init__(self, source, source_size):
+        self.inodes = {}
+        self.data = defaultdict(dict)
+        self.children = defaultdict(list)
+        self.notes = []
+        head, body = read_node(source, 0, source_size, 4096)
+        if head.node_type != d.UBIFS_SB_NODE:
+            raise ValueError("UBIFS image does not start with a superblock")
+        sb = nodes.sb_node(body)
+        self.superblock = sb
+        if (not 4096 <= sb.leb_size <= source_size or not 3 <= sb.leb_cnt <= sb.max_leb_cnt
+                or sb.leb_size * sb.leb_cnt > source_size
+                or sb.min_io_size < 8 or sb.min_io_size & (sb.min_io_size - 1)
+                or sb.leb_size % sb.min_io_size or sb.min_io_size > sb.leb_size):
+            raise ValueError("Invalid UBIFS geometry or truncated logical erase blocks")
+        if sb.key_fmt != 0 or sb.key_hash not in (0, 1) or sb.fmt_version > 5 or sb.ro_compat_version > 0:
+            raise ValueError("Unknown UBIFS key or on-flash format")
+        if sb.flags & ~14:
+            raise ValueError("Encrypted, authenticated or unknown UBIFS feature requires its own decoder")
+        if not 3 <= sb.fanout <= (sb.leb_size - 28) // d.UBIFS_BRANCH_SZ:
+            raise ValueError("Invalid UBIFS index fanout")
+
+        masters = []
+        step = ((512 + sb.min_io_size - 1) // sb.min_io_size) * sb.min_io_size
+        for leb in (1, 2):
+            candidates = []
+            for offset in range(0, sb.leb_size - 511, step):
+                position = leb * sb.leb_size + offset
+                source.seek(position)
+                if source.read(4) == b"\xff" * 4:
+                    break
+                ch, data = read_node(source, position, (leb + 1) * sb.leb_size, 512)
+                if ch.node_type != d.UBIFS_MST_NODE:
+                    raise ValueError("Unexpected node in UBIFS master area")
+                candidates.append((ch.sqnum, nodes.mst_node(data)))
+            if not candidates:
+                raise ValueError("UBIFS master copy is absent; commit identity is unknown")
+            masters.append(max(candidates, key=lambda item: item[0])[1])
+        identity = lambda m: (m.cmt_no, m.root_lnum, m.root_offs, m.root_len, m.leb_cnt, m.flags)
+        if identity(masters[0]) != identity(masters[1]):
+            raise ValueError("UBIFS master copies disagree; commit identity is unknown")
+        master = masters[0]
+        self.commit = master.cmt_no
+        if master.leb_cnt != sb.leb_cnt or master.flags & ~7:
+            raise ValueError("UBIFS master geometry or flags disagree with the superblock")
+        if master.flags & (d.UBIFS_MST_DIRTY | d.UBIFS_MST_RCVRY):
+            self.notes.append("Committed UBIFS index recovered; dirty/recovery journal state was not replayed and current files remain uncertain")
+        if not master.flags & d.UBIFS_MST_NO_ORPHS:
+            self.notes.append("UBIFS orphan processing was not applied to the committed index")
+
+        pending = [(master.root_lnum, master.root_offs, master.root_len, None, None)]
+        seen = set()
+        names = set()
+        while pending:
+            leb, offset, length, level, parent_key = pending.pop()
+            if len(seen) >= 100_000:
+                raise ValueError("UBIFS index exceeds its 100000-node work bound")
+            if (leb, offset) in seen:
+                raise ValueError("UBIFS index contains a repeated address or cycle")
+            if not 3 <= leb < sb.leb_cnt or offset < 0 or offset % 8:
+                raise ValueError("UBIFS branch points outside the main area or is unaligned")
+            seen.add((leb, offset))
+            head, body = read_node(source, leb * sb.leb_size + offset,
+                                   (leb + 1) * sb.leb_size, length)
+            if head.node_type == d.UBIFS_IDX_NODE:
+                index = nodes.idx_node(body)
+                if not 0 <= index.level < d.UBIFS_MAX_LEVELS or not 0 < index.child_cnt <= sb.fanout:
+                    raise ValueError("UBIFS index level or child count exceeds its format bound")
+                if level is not None and index.level != level:
+                    raise ValueError("UBIFS child index level disagrees with its parent")
+                if len(body) != d.UBIFS_IDX_NODE_SZ + index.child_cnt * d.UBIFS_BRANCH_SZ:
+                    raise ValueError("UBIFS index has an unknown branch layout")
+                if parent_key is not None and index.branches[0].key != parent_key:
+                    raise ValueError("UBIFS child index key disagrees with its parent")
+                previous = None
+                for branch in index.branches:
+                    order = (branch.key['ino_num'], branch.key['type'], branch.key['value'])
+                    if previous is not None and order < previous:
+                        raise ValueError("UBIFS index keys are not ordered")
+                    previous = order
+                    pending.append((branch.lnum, branch.offs, branch.len, index.level - 1, branch.key))
+            else:
+                if level != -1:
+                    raise ValueError("UBIFS leaf occurs at an unexpected index depth")
+                if head.node_type == d.UBIFS_INO_NODE:
+                    node = nodes.ino_node(body)
+                    if len(body) != d.UBIFS_INO_NODE_SZ + node.data_len:
+                        raise ValueError("UBIFS inode inline length mismatch")
+                    if node.key['ino_num'] in self.inodes:
+                        raise ValueError("UBIFS index contains duplicate inode identities")
+                    self.inodes[node.key['ino_num']] = node
+                elif head.node_type == d.UBIFS_DATA_NODE:
+                    node = nodes.data_node(body, leb * sb.leb_size + offset + 48)
+                    if not 0 < node.size <= d.UBIFS_BLOCK_SIZE or node.compr_size:
+                        raise ValueError("UBIFS data node has invalid or encrypted extents")
+                    blocks = self.data[node.key['ino_num']]
+                    if node.key['value'] in blocks:
+                        raise ValueError("UBIFS index contains duplicate data block identities")
+                    blocks[node.key['value']] = DataBlock(node, body[d.UBIFS_DATA_NODE_SZ:])
+                elif head.node_type in (d.UBIFS_DENT_NODE, d.UBIFS_XENT_NODE):
+                    node = nodes.dent_node(body)
+                    if head.node_type == d.UBIFS_XENT_NODE:
+                        if "Extended UBIFS metadata retained in input, not applied to Windows" not in self.notes:
+                            self.notes.append("Extended UBIFS metadata retained in input, not applied to Windows")
+                    else:
+                        key = (node.key['ino_num'], node.name)
+                        if key in names or not node.inum:
+                            raise ValueError("UBIFS committed directory contains duplicate or removed entries")
+                        names.add(key)
+                        self.children[node.key['ino_num']].append(node)
+                else:
+                    raise ValueError(f"Unknown UBIFS indexed node type {head.node_type}")
+                if node.key != parent_key or node.key['type'] != head.node_type:
+                    raise ValueError("UBIFS node key/type disagrees with its index branch")
+        if d.UBIFS_ROOT_INO not in self.inodes:
+            raise ValueError("UBIFS committed index has no root inode")
