+# Enable colors only for a real console, without starting a shell on import.
+# Redirected output (including the isolated worker pipe) needs no console mode.
+if platform == "windows" and sys.stdout is not None and sys.stdout.isatty():
+    import ctypes
+    import msvcrt
+    _console = ctypes.c_void_p(msvcrt.get_osfhandle(sys.stdout.fileno()))
+    _kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    _kernel32.GetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]
+    _kernel32.GetConsoleMode.restype = ctypes.c_int
+    _kernel32.SetConsoleMode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
+    _kernel32.SetConsoleMode.restype = ctypes.c_int
+    _mode = ctypes.c_ulong()
+    if _kernel32.GetConsoleMode(_console, ctypes.byref(_mode)):
+        _kernel32.SetConsoleMode(_console, _mode.value | 0x0004)
 
