+            count = total = 0
+            while pending:
+                parent, path = pending.popleft()
+                if parent in visited or len(path) > 128:
+                    raise ValueError("UBIFS directory cycle, alias or depth bound")
+                visited.add(parent)
+                inode = tree.inodes.get(parent)
+                if inode is None or not stat.S_ISDIR(inode.mode):
+                    raise ValueError("UBIFS parent is not a verified directory inode")
