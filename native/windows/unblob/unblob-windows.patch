+"""Extract ZIP with the admitted native Python codecs and Windows path checks."""
+import stat
+import zipfile
+from unblob.models import Extractor, ExtractResult
+from unblob.report import ExtractionProblem, UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+
+class WindowsZipExtractor(Extractor):
+    def extract(self, inpath, outdir):
+        reports = []
+        total = 0
+        with zipfile.ZipFile(inpath) as archive:
+            for member in archive.infolist():
+                original_name = member.orig_filename
+                try:
+                    relative = checked_windows_archive_path(outdir, original_name, posix_source=True)
+                    if original_name != member.filename:
+                        raise ValueError("ZIP decoder normalized the original archive filename")
+                    target = outdir / relative
+                    mode = member.external_attr >> 16
+                    file_type = stat.S_IFMT(mode)
+                    if file_type not in (0, stat.S_IFREG, stat.S_IFDIR):
+                        reports.append(ExtractionProblem(
+                            path=original_name,
+                            problem=f"ZIP entry is not a regular file or directory (source mode {mode:o}).",
+                            resolution="Entry metadata retained; no special file or link created.",
+                        ))
+                        continue
+                    if member.is_dir():
+                        target.mkdir(parents=True, exist_ok=True)
+                        continue
+                    if member.file_size > MAX_OUTPUT_BYTES - total:
+                        raise ValueError("ZIP entry exceeds the remaining 512 MiB output bound")
+                    target.parent.mkdir(parents=True, exist_ok=True)
+                    written = 0
+                    with archive.open(member) as source, target.open('xb') as output:
+                        while data := source.read(CHUNK_BYTES):
+                            if len(data) > MAX_OUTPUT_BYTES - total or len(data) > member.file_size - written:
+                                raise ValueError("ZIP expansion exceeds its admitted size")
+                            output.write(data)
+                            written += len(data)
+                            total += len(data)
+                    if written != member.file_size:
+                        raise EOFError("ZIP entry ended before its declared size")
+                except (ValueError, FileExistsError) as error:
+                    reports.append(ExtractionProblem(
+                        path=original_name, problem=str(error),
+                        resolution="Skipped; prior output and original archive coordinates retained.",
+                    ))
+                except Exception as error:
+                    reports.append(UnknownError(exception=error))
+        return ExtractResult(reports=reports)
