+"""Read native archive formats inside REA's single AppContainer worker.
+
+The library only decodes entries. This owner validates every output path and
+writes regular files itself; libarchive's filesystem extraction API is unused.
+"""
+import ctypes
+from functools import lru_cache
+from pathlib import Path
+import stat
+
+from unblob.models import Extractor, ExtractResult, DirectoryExtractor
+from unblob.report import ExtractionProblem, UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+MAX_ENTRIES = 10000
+
+
+@lru_cache(maxsize=1)
+def _library():
+    path = Path(__file__).parent / "_windows_native" / "libarchive-13.dll"
+    # Only this admitted directory and Windows system DLLs may resolve imports.
+    lib = ctypes.CDLL(str(path), winmode=0x100 | 0x800)
+    pointer = ctypes.c_void_p
+    signatures = {
+        "archive_read_new": (pointer, []),
+        "archive_read_support_filter_none": (ctypes.c_int, [pointer]),
+        "archive_read_open_filename_w": (ctypes.c_int, [pointer, ctypes.c_wchar_p, ctypes.c_size_t]),
+        "archive_read_open_memory": (ctypes.c_int, [pointer, pointer, ctypes.c_size_t]),
+        "archive_read_next_header": (ctypes.c_int, [pointer, ctypes.POINTER(pointer)]),
+        "archive_read_data": (ctypes.c_ssize_t, [pointer, pointer, ctypes.c_size_t]),
+        "archive_read_data_skip": (ctypes.c_int, [pointer]),
+        "archive_read_free": (ctypes.c_int, [pointer]),
+        "archive_error_string": (ctypes.c_char_p, [pointer]),
+        "archive_entry_pathname_utf8": (ctypes.c_char_p, [pointer]),
+        "archive_entry_filetype": (ctypes.c_uint, [pointer]),
+        "archive_entry_size": (ctypes.c_int64, [pointer]),
+        "archive_entry_size_is_set": (ctypes.c_int, [pointer]),
+        "archive_entry_symlink": (pointer, [pointer]),
+        "archive_entry_hardlink": (pointer, [pointer]),
+        "archive_entry_is_encrypted": (ctypes.c_int, [pointer]),
+    }
+    for kind in ("7zip", "cab", "rar", "rar5", "iso9660"):
+        signatures["archive_read_support_format_" + kind] = (ctypes.c_int, [pointer])
+    for name, (result, args) in signatures.items():
+        function = getattr(lib, name)
+        function.restype = result
+        function.argtypes = args
+    return lib
+
+
+class WindowsLibarchiveExtractor(Extractor):
+    def __init__(self, kind):
+        if kind not in ("7zip", "cab", "rar", "iso9660"):
+            raise ValueError("Unsupported fixed Windows archive adapter")
+        self.kind = kind
+
+    def extract(self, inpath, outdir):
+        return self._extract(inpath, outdir)
+
+    def _extract(self, inpath, outdir, joined=None):
+        lib = _library()
+        archive = lib.archive_read_new()
+        if not archive:
+            raise MemoryError("Unable to allocate native archive reader")
+        reports = []
+        total = 0
+
+        def checked(status):
+            if status < 0:
+                reason = lib.archive_error_string(archive)
+                raise ValueError("Native archive decoding failed: " +
+                    (reason.decode("utf-8", "backslashreplace") if reason else str(status)))
+
+        try:
+            checked(lib.archive_read_support_filter_none(archive))
+            for kind in (("rar", "rar5") if self.kind == "rar" else (self.kind,)):
+                checked(getattr(lib, "archive_read_support_format_" + kind)(archive))
+            if joined is None:
+                checked(lib.archive_read_open_filename_w(archive, str(inpath), CHUNK_BYTES))
+            else:
+                # The directory owner selects and orders parts. Keep the single
+                # bounded allocation alive for the entire native reader lifetime.
+                backing = (ctypes.c_char * len(joined)).from_buffer(joined)
+                checked(lib.archive_read_open_memory(archive, backing, len(joined)))
+            buffer = ctypes.create_string_buffer(CHUNK_BYTES)
+            entry = ctypes.c_void_p()
+            count = 0
+            while True:
+                status = lib.archive_read_next_header(archive, ctypes.byref(entry))
+                if status == 1:  # ARCHIVE_EOF
+                    break
+                checked(status)
+                count += 1
+                if count > MAX_ENTRIES:
+                    raise ValueError("Native archive exceeds the 10000 entry resource bound")
+                name_bytes = lib.archive_entry_pathname_utf8(entry)
+                if name_bytes is None:
+                    raise ValueError("Native archive has no lossless UTF-8 entry coordinate")
+                original_name = name_bytes.decode("utf-8", "strict")
+                try:
+                    relative = checked_windows_archive_path(
+                        outdir, original_name, posix_source=self.kind != "cab"
+                    )
+                    target = outdir / relative
+                    file_type = lib.archive_entry_filetype(entry)
+                    if (lib.archive_entry_symlink(entry) or lib.archive_entry_hardlink(entry)
+                            or file_type not in (stat.S_IFREG, stat.S_IFDIR)):
+                        raise ValueError("Entry is a link or special file; its metadata cannot be materialized as a Windows regular file")
+                    if lib.archive_entry_is_encrypted(entry):
+                        raise ValueError("Encrypted entry requires an explicitly supplied credential; none was supplied")
+                    if file_type == stat.S_IFDIR:
+                        target.mkdir(parents=True, exist_ok=True)
+                        checked(lib.archive_read_data_skip(archive))
+                        continue
+                    size = lib.archive_entry_size(entry) if lib.archive_entry_size_is_set(entry) else None
+                    if size is not None and (size < 0 or size > MAX_OUTPUT_BYTES - total):
+                        raise ValueError("Entry exceeds the remaining 512 MiB output bound")
+                    target.parent.mkdir(parents=True, exist_ok=True)
+                    written = 0
+                    with target.open("xb") as output:
+                        while True:
+                            amount = lib.archive_read_data(archive, buffer, CHUNK_BYTES)
+                            checked(amount)
+                            if amount == 0:
+                                break
+                            if amount > MAX_OUTPUT_BYTES - total or (size is not None and amount > size - written):
+                                raise ValueError("Native archive expansion exceeds its admitted size")
+                            output.write(buffer.raw[:amount])
+                            total += amount
+                            written += amount
+                    if size is not None and written != size:
+                        raise EOFError("Native archive entry ended before its declared size")
+                except (ValueError, FileExistsError) as error:
+                    reports.append(ExtractionProblem(
+                        path=original_name, problem=str(error),
+                        resolution="Skipped or partial; prior output and decoded source coordinate retained.",
+                    ))
+                    checked(lib.archive_read_data_skip(archive))
+        except Exception as error:
+            reports.append(UnknownError(exception=error))
+        finally:
+            if lib.archive_read_free(archive) < 0:
+                reports.append(ExtractionProblem(
+                    path=str(inpath), problem="Native archive reader reported an error during close.",
+                    resolution="Known output retained; extraction remains partial.",
+                ))
+        return ExtractResult(reports=reports)
+
+
+class WindowsMultiSevenZipExtractor(DirectoryExtractor):
+    def extract(self, paths, outdir):
+        try:
+            if not 1 <= len(paths) <= MAX_ENTRIES:
+                raise ValueError("7z volume count exceeds the 10000-entry input bound")
+            sizes = [path.stat().st_size for path in paths]
+            total = sum(sizes)
+            if total <= 0 or total > 128 * 1024 * 1024:
+                raise ValueError("7z joined stream exceeds the 128 MiB input bound")
+            joined = bytearray(total)
+            view = memoryview(joined)
+            offset = 0
+            for path, size in zip(paths, sizes):
+                if path.is_symlink() or not path.is_file():
+                    raise ValueError("7z volume is not a regular admitted file")
+                with path.open('rb') as source:
+                    end = offset + size
+                    while offset < end:
+                        amount = source.readinto(view[offset:min(end,offset+CHUNK_BYTES)])
+                        if not amount:
+                            raise EOFError("7z volume ended before its selected extent")
+                        offset += amount
+                    if source.read(1):
+                        raise ValueError("7z volume grew after its extent was selected")
+            return WindowsLibarchiveExtractor('7zip')._extract(paths[0], outdir, joined)
+        except Exception as error:
+            return ExtractResult(reports=[UnknownError(exception=error)])
