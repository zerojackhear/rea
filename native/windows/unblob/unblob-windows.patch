+"""Native library-backed Windows decompression without shell subprocesses."""
+import bz2
+import contextlib
+import gzip
+import io
+import lzma
+import struct
+from pathlib import Path
+
+from unblob.models import ExtractError, Extractor
+from unblob.report import UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+
+CHUNK_BYTES = 64 * 1024
+# Matches the maximum output admitted by REA's firmware request contract.
+# The caller still enforces its smaller selected aggregate output budget.
+MAX_OUTPUT_BYTES = 512 * 1024 * 1024
+
+
+class JoinedInput(io.RawIOBase):
+    """A bounded sequential view over producer-ordered multi-volume files."""
+    def __init__(self, paths):
+        super().__init__()
+        self.paths = iter(paths)
+        self.current = None
+
+    def readable(self):
+        return True
+
+    def readinto(self, destination):
+        if not destination:
+            return 0
+        while True:
+            if self.current is None:
+                path = next(self.paths, None)
+                if path is None:
+                    return 0
+                self.current = Path(path).open('rb')
+            count = self.current.readinto(destination)
+            if count:
+                return count
+            self.current.close()
+            self.current = None
+
+    def close(self):
+        if self.current is not None:
+            self.current.close()
+            self.current = None
+        super().close()
+
+
+class WindowsStreamExtractor(Extractor):
+    def __init__(self, kind, filename):
+        self.kind = kind
+        self.filename = filename
+
+    def _reader(self, source):
+        if self.kind == 'gzip':
+            return gzip.GzipFile(fileobj=source, mode='rb')
+        if self.kind == 'bz2':
+            return bz2.BZ2File(source, mode='rb')
+        if self.kind in ('xz', 'lzma'):
+            return lzma.LZMAFile(source, mode='rb', format=lzma.FORMAT_XZ if self.kind == 'xz' else lzma.FORMAT_ALONE)
+        if self.kind == 'zstd':
+            from pyzstd import ZstdFile
+            return ZstdFile(source, mode='rb')
+        if self.kind == 'lz4':
+            from lz4.frame import LZ4FrameFile
+            return LZ4FrameFile(source, mode='rb')
+        raise ValueError('Unknown native decoder: '+self.kind)
+
+    def _chunks(self, source):
+        if self.kind == 'lz4' and source.peek(4)[:4] == b'\x02\x21\x4c\x18':
+            from lz4.block import decompress
+            source.read(4)
+            block_size = 8 * 1024 * 1024
+            compressed_bound = block_size + block_size // 255 + 16
+            while True:
+                header = source.read(4)
+                if not header:
+                    return
+                if len(header) != 4:
+                    raise EOFError('Incomplete LZ4 legacy block length')
+                length = struct.unpack('<I',header)[0]
+                if not 0 < length <= compressed_bound:
+                    raise ValueError('LZ4 legacy compressed block exceeds its format bound')
+                compressed = source.read(length)
+                if len(compressed) != length:
+                    raise EOFError('Incomplete LZ4 legacy block')
+                yield decompress(compressed, uncompressed_size=block_size)
+        else:
+            with self._reader(source) as reader:
+                while data := reader.read(CHUNK_BYTES):
+                    yield data
+
+    def extract_paths(self, paths, outdir):
+        try:
+            relative = checked_windows_archive_path(outdir, self.filename)
+            destination = outdir / relative
+            destination.parent.mkdir(parents=True,exist_ok=True)
+            with contextlib.ExitStack() as stack:
+                source = stack.enter_context(io.BufferedReader(JoinedInput(paths),buffer_size=CHUNK_BYTES))
+                output = stack.enter_context(destination.open('xb'))
+                total = 0
+                for data in self._chunks(source):
+                    if len(data) > MAX_OUTPUT_BYTES - total:
+                        raise ValueError('Native decompression exceeds the 512 MiB output bound')
+                    output.write(data)
+                    total += len(data)
+        except Exception as error:
+            # Preserve decoder failures and any partial output. Never report a
+            # checksum, truncation, dictionary or resource failure as success.
+            raise ExtractError(UnknownError(exception=error)) from error
+
+    def extract(self, inpath, outdir):
+        return self.extract_paths([inpath],outdir)
