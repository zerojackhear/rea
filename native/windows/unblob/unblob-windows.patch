+"""Bounded flash-node codecs. Corrupt compressed input is never zero-filled."""
+import ctypes
+from functools import lru_cache
+import lzma
+from pathlib import Path
+import zlib
+
+MAX_NODE_BYTES = 128 * 1024 * 1024
+
+
+@lru_cache(maxsize=1)
+def _lzo():
+    # The DLL and its dependencies are part of the sealed engine inventory.
+    dll = ctypes.CDLL(str(Path(__file__).parent / "_windows_native" / "rea-lzo.dll"),
+                      winmode=0x100 | 0x800)
+    decode = dll.rea_lzo_decode
+    decode.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p,
+                       ctypes.c_size_t, ctypes.POINTER(ctypes.c_size_t)]
+    decode.restype = ctypes.c_int
+    return dll
+
+
+def decode_flash_node(data, expected, codec):
+    if not 0 <= expected <= MAX_NODE_BYTES or len(data) > MAX_NODE_BYTES:
+        raise ValueError("Flash node exceeds the 128 MiB decoder buffer bound")
+    if codec == "none":
+        output = data
+    elif codec == "zero":
+        if data:
+            raise ValueError("Zero-compressed node contains unexpected encoded bytes")
+        output = bytes(expected)
+    elif codec in ("zlib", "deflate"):
+        decoder = zlib.decompressobj(-11 if codec == "deflate" else 15)
+        output = decoder.decompress(data, expected + 1)
+        if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:
+            raise ValueError("Zlib node has a truncated, trailing or oversized stream")
+    elif codec == "zstd":
+        from pyzstd import DParameter, ZstdDecompressor
+        decoder = ZstdDecompressor(option={DParameter.windowLogMax: 27})
+        output = decoder.decompress(data, max_length=expected + 1)
+        if not decoder.eof or decoder.unused_data:
+            raise ValueError("Zstd node has a truncated, trailing or oversized stream")
+    elif codec == "lzo":
+        output_buffer = ctypes.create_string_buffer(max(1, expected))
+        written = ctypes.c_size_t()
+        result = _lzo().rea_lzo_decode(data, len(data), output_buffer, expected,
+                                      ctypes.byref(written))
+        if result != 0 or written.value > expected:
+            raise ValueError(f"LZO node decode failed (result {result})")
+        output = output_buffer.raw[:written.value]
+    elif codec == "rtime":
+        output = bytearray(expected)
+        positions = [0] * 256
+        cursor = 0
+        for offset in range(0, len(data), 2):
+            if offset + 1 >= len(data) or cursor >= expected:
+                raise ValueError("RTIME node has a truncated or trailing pair")
+            value, repeat = data[offset:offset + 2]
+            output[cursor] = value
+            cursor += 1
+            back = positions[value]
+            positions[value] = cursor
+            if repeat > expected - cursor or back >= cursor:
+                raise ValueError("RTIME node exceeds its declared output extent")
+            for _ in range(repeat):
+                output[cursor] = output[back]
+                cursor += 1
+                back += 1
+        if cursor != expected:
+            raise ValueError("RTIME node is shorter than its declared output extent")
+    elif codec in ("lzma", "lzma-no-size"):
+        if codec == "lzma":
+            prefix, compressed = b"\0\0\x20\0\0", data
+        else:
+            if len(data) < 5:
+                raise ValueError("Truncated LZMA node properties")
+            prefix, compressed = data[:5], data[5:]
+        decoder = lzma.LZMADecompressor(format=lzma.FORMAT_ALONE, memlimit=MAX_NODE_BYTES)
+        output = decoder.decompress(prefix + expected.to_bytes(8, "little") + compressed,
+                                    max_length=expected + 1)
+        if not decoder.eof or decoder.unused_data:
+            raise ValueError("LZMA node has a truncated, trailing or oversized stream")
+    else:
+        raise ValueError(f"Unknown flash compression: {codec}")
+    if len(output) != expected:
+        raise ValueError("Decoded flash node length disagrees with its declared size")
+    return output
