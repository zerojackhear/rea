+"""Restore admitted Partclone v2 blocks to a regular file, never a device."""
+import binascii
+import hashlib
+import json
+
+from unblob.models import Extractor, ExtractResult
+from unblob.report import UnknownError
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+
+class WindowsPartcloneExtractor(Extractor):
+    def extract(self, inpath, outdir):
+        from unblob.handlers.archive.partclone import PartcloneHandler, partclone_image_layout
+        reports = []
+        try:
+            with inpath.open("rb") as source:
+                header = PartcloneHandler().read_image_header(source, 0)
+                layout = partclone_image_layout(header)
+                # BM_BIT is a native-word bitmap in the producer. Do not guess
+                # the byte ordering of an image made by a different architecture.
+                if header.endian != b"\xde\xc0":
+                    raise ValueError("Partclone big-endian bitmap layout is not established")
+                if header.bitmap_mode not in (0, 1):
+                    raise ValueError("Partclone byte bitmap trailer semantics are not established for v2")
+                if header.checksum_mode not in (0, 0x20):
+                    raise ValueError("Partclone checksum algorithm is not admitted by this reader")
+                block_size, blocks = header.fs_block_size, header.fs_total_block_count
+                if (header.fs_size > MAX_OUTPUT_BYTES - 4096 or block_size > 4 * 1024 * 1024
+                        or blocks > 8 * 1024 * 1024):
+                    raise ValueError("Partclone expansion exceeds the 512 MiB output or bounded bitmap limit")
+                if inpath.stat().st_size != layout['image_bytes']:
+                    raise ValueError("Partclone input length disagrees with its complete extent")
+
+                def read_exact(amount):
+                    data = source.read(amount)
+                    if len(data) != amount:
+                        raise EOFError("Truncated Partclone data; missing bytes were not synthesized")
+                    return data
+
+                bitmap = read_exact(layout['bitmap_bytes'])
+                if header.bitmap_mode == 1:
+                    expected = int.from_bytes(read_exact(4), 'little')
+                    if binascii.crc32(bitmap) ^ 0xFFFFFFFF != expected:
+                        raise ValueError("Partclone bitmap CRC32 mismatch")
+                    used = sum(value.bit_count() for value in bitmap)
+                    # Some producers set the unused final bits. They are outside
+                    # the filesystem and never contribute to the used count.
+                    if blocks % 8:
+                        used -= (bitmap[-1] >> (blocks % 8)).bit_count()
+                else:
+                    used = blocks
+                if used != header.fs_used_block_count_bitmap:
+                    raise ValueError("Partclone used-block count disagrees with the verified bitmap")
+                data_offset = source.tell()
+                # Validate the entire selected data stream before exposing a
+                # restored image. Validation is streaming, even for huge groups.
+                crc, in_group = 0, 0
+                for index in range(used):
+                    remaining = block_size
+                    while remaining:
+                        data = read_exact(min(CHUNK_BYTES, remaining))
+                        crc = binascii.crc32(data, crc); remaining -= len(data)
+                    in_group += 1
+                    if header.checksum_mode and (in_group == header.blocks_per_checksum or index + 1 == used):
+                        expected = int.from_bytes(read_exact(4), 'little')
+                        if crc ^ 0xFFFFFFFF != expected:
+                            raise ValueError(f"Partclone data CRC32 mismatch after used block {index + 1}")
+                        in_group = 0
+                        if header.reseed_checksum:
+                            crc = 0
+                if source.tell() != layout['image_bytes']:
+                    raise ValueError("Partclone stream has an unexplained trailing extent")
+                source.seek(data_offset)
+                image = outdir / 'partclone.restored'
+                ordinal = 0
+                with image.open('xb') as output:
+                    for index in range(blocks):
+                        present = not bitmap or bitmap[index // 8] & (1 << (index % 8))
+                        if not present:
+                            continue
+                        output.seek(index * block_size)
+                        remaining = block_size
+                        while remaining:
+                            data = read_exact(min(CHUNK_BYTES, remaining))
+                            available = max(0, header.fs_size - output.tell())
+                            output.write(data[:available]); remaining -= len(data)
+                        ordinal += 1
+                        if header.checksum_mode and (ordinal % header.blocks_per_checksum == 0 or ordinal == used):
+                            read_exact(4)
+                    output.truncate(header.fs_size)
+                # Free source blocks were omitted by Partclone. A zero-filled
+                # output hole is a representation, not recovered original bytes.
+                mapping = {
+                    'schemaVersion': 1, 'format': 'partclone-v2',
+                    'source_filesystem_bytes': header.fs_type.hex(),
+                    'source_bytes': layout['image_bytes'], 'output': image.name,
+                    'output_bytes': header.fs_size, 'block_bytes': block_size,
+                    'total_blocks': blocks, 'copied_blocks': used,
+                    'bitmap_mode': header.bitmap_mode,
+                    'bitmap_sha256': hashlib.sha256(bitmap).hexdigest(),
+                    'checksum_mode': header.checksum_mode,
+                    'unallocated_source_content': 'unknown; not stored in this image',
+                    'unallocated_output_representation': 'zero-filled file holes',
+                    'metadata_changes': 'none; no filesystem fixups or host permissions applied',
+                }
+                (outdir/'partclone-map.json').write_text(json.dumps(mapping,indent=2),encoding='utf-8')
+        except Exception as error:
+            reports.append(UnknownError(exception=error))
+        return ExtractResult(reports=reports)
