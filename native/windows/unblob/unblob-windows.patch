+def partclone_image_layout(header):
+    """Own the on-disk extents for the v2 header used by both adapters."""
+    if (header.magic != b"partclone-image\0" or header.image_version_txt != b"0002"
+            or header.image_version != 2 or header.feature_size != 18
+            or header.number_of_bits_for_CPU not in (32, 64)
+            or header.reseed_checksum not in (0, 1)):
+        raise InvalidInputFormat("Unsupported or inconsistent Partclone v2 header")
+    blocks, used, size = header.fs_total_block_count, header.fs_used_block_count_bitmap, header.fs_block_size
+    if (not blocks or not size or used > blocks
+            or not (blocks - 1) * size < header.fs_size <= blocks * size):
+        raise InvalidInputFormat("Invalid Partclone filesystem geometry")
+    checksums = {0: 0, 0x20: 4, 0x30: 8, 0x31: 16}
+    if (header.checksum_mode not in checksums
+            or header.checksum_size != checksums[header.checksum_mode]
+            or (header.checksum_mode and not header.blocks_per_checksum)
+            or (not header.checksum_mode and header.blocks_per_checksum)):
+        raise InvalidInputFormat("Inconsistent Partclone checksum mode or group size")
+    if header.bitmap_mode == 1:
+        bitmap_bytes, trailer_bytes = (blocks + 7) // 8, 4
+    elif header.bitmap_mode == 0:
+        if used != blocks:
+            raise InvalidInputFormat("Partclone bitmap-free image omits blocks")
+        bitmap_bytes, trailer_bytes = 0, 0
+    elif header.bitmap_mode == 8:
+        bitmap_bytes, trailer_bytes = blocks, 4
+    else:
+        raise InvalidInputFormat("Unknown Partclone bitmap mode")
+    groups = (used + header.blocks_per_checksum - 1) // header.blocks_per_checksum if header.checksum_mode else 0
+    return {'bitmap_bytes': bitmap_bytes, 'bitmap_trailer_bytes': trailer_bytes,
+            'image_bytes': len(header) + bitmap_bytes + trailer_bytes + used * size + groups * header.checksum_size}
+
