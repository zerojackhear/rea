+"""Native Windows binding for the streaming contract used by Unblob 26.6.4.
+
+This adapter uses hyperscan 0.9.1; it is not a pyperscan distribution.
+Offsets, pattern tags, termination and reset follow the pinned producer API.
+"""
+from enum import IntEnum, IntFlag
+
+import hyperscan
+
+
+class Flag(IntFlag):
+    SOM_LEFTMOST = hyperscan.HS_FLAG_SOM_LEFTMOST
+    DOTALL = hyperscan.HS_FLAG_DOTALL
+
+
+class Scan(IntEnum):
+    Continue = 0
+    Terminate = 1
+
+
+class Pattern:
+    def __init__(self, expression: bytes, *flags: Flag, tag=None):
+        if not isinstance(expression, bytes):
+            raise TypeError("Pattern expression must retain its source bytes")
+        if b"\x00" in expression:
+            raise ValueError("Regex source cannot contain a NUL byte; use an escaped byte expression")
+        self.expression = expression
+        self.flags = 0
+        for flag in flags:
+            self.flags |= int(flag)
+        self.tag = tag
+
+
+class StreamDatabase:
+    def __init__(self, *patterns: Pattern):
+        if not patterns:
+            raise ValueError("A stream database requires patterns")
+        self.tags = tuple(index if p.tag is None else p.tag for index, p in enumerate(patterns))
+        self.database = hyperscan.Database(
+            mode=hyperscan.HS_MODE_STREAM | hyperscan.HS_MODE_SOM_HORIZON_LARGE
+        )
+        self.database.compile(
+            expressions=[p.expression for p in patterns],
+            ids=list(range(len(patterns))),
+            flags=[p.flags for p in patterns],
+        )
+
+    def build(self, context, on_match):
+        return StreamScanner(self, context, on_match)
+
+
+def _discard_match(*_args):
+    return False
+
+
+class StreamScanner:
+    def __init__(self, owner, context, on_match):
+        self.owner = owner
+        self.context = context
+        self.on_match = on_match
+        self.scratch = hyperscan.Scratch(owner.database)
+        self.stream = None
+        self._callback_error = None
+        self._terminated = False
+        # Keep one callback identity across resets. The fixed native stream
+        # owns its references and participates in cyclic garbage collection.
+        self._callback = self._match
+        self._open()
+
+    def _open(self):
+        self.stream = self.owner.database.stream(
+            match_event_handler=self._callback, context=self.context
+        )
+        self.stream.__enter__()
+
+    def _match(self, expression_id, start, end, _flags, _context):
+        try:
+            result = self.on_match(self.context, self.owner.tags[expression_id], start, end)
+            if not isinstance(result, Scan):
+                raise TypeError("Match callback must return Scan")
+            self._terminated = result is Scan.Terminate
+        except BaseException as error:
+            self._callback_error = error
+            self._terminated = True
+        return self._terminated
+
+    def _call(self, operation):
+        self._callback_error = None
+        try:
+            operation()
+        except hyperscan.ScanTerminated:
+            if not self._terminated and self._callback_error is None:
+                raise
+        if self._callback_error is not None:
+            error, self._callback_error = self._callback_error, None
+            raise error
+        return Scan.Terminate if self._terminated else Scan.Continue
+
+    def scan(self, data, chunk_size=None):
+        if self.stream is None:
+            raise RuntimeError("Cannot scan a closed stream")
+        if self._terminated:
+            return Scan.Terminate
+        if chunk_size is not None and (not isinstance(chunk_size, int) or chunk_size <= 0):
+            raise ValueError("chunk_size must be a positive integer")
+        with memoryview(data) as view:
+            size = chunk_size or len(view) or 1
+            for start in range(0, len(view), size):
+                with view[start : start + size] as part:
+                    result = self._call(lambda: self.stream.scan(part, scratch=self.scratch))
+                if result is Scan.Terminate:
+                    return result
+        return Scan.Continue
+
+    def reset(self):
+        if self.stream is None:
+            raise RuntimeError("Cannot reset a closed stream")
+        stream, self.stream = self.stream, None
+        self._terminated = False
+        try:
+            result = self._call(lambda: stream.close(scratch=self.scratch))
+        finally:
+            self._terminated = False
+            self._open()
+        return result
+
+    def close(self):
+        if self.stream is not None:
+            stream, self.stream = self.stream, None
+            # Producer destruction discards end-of-stream matches; reset() above
+            # instead preserves its callback semantics.
+            stream.close(scratch=self.scratch, match_event_handler=_discard_match)
+
+    def __del__(self):
+        if hasattr(self, "stream"):
+            self.close()
