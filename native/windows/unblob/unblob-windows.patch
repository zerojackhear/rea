+"""Admit archive coordinates without Win32 aliases or hidden data streams."""
+import ntpath
+from pathlib import Path
+
+
+def checked_windows_archive_path(root: Path, raw: str, *, posix_source=False) -> Path:
+    if posix_source and "\\" in raw:
+        raise ValueError("Archive filename contains a literal backslash that Windows would reinterpret")
+    drive, _ = ntpath.splitdrive(raw)
+    if drive or raw.startswith(("/", "\\")):
+        raise ValueError("Windows extraction cannot preserve an anchored archive path")
+    parts = raw.replace("\\", "/").split("/")
+    for part in parts:
+        if part in ("", ".", ".."):
+            continue
+        if ntpath.isreserved(part):
+            raise ValueError("Archive name uses a reserved Windows name, character or data stream")
+    relative = Path(raw)
+    boundary = root.resolve()
+    target = boundary / relative
+    if not target.resolve().is_relative_to(boundary):
+        raise ValueError("Archive path escapes the extraction directory")
+    current = boundary
+    for part in relative.parts:
+        if part == "..":
+            current = current.parent
+            continue
+        current = current / part
+        if current.exists() or current.is_symlink():
+            # Compare source spelling to the OS-resolved spelling, not a
+            # case-folding approximation of the filesystem's Unicode rules.
+            observed = current.resolve(strict=True)
+            if observed.name != part:
+                raise ValueError("Archive name aliases an existing Windows entry with different spelling")
+            if not observed.is_relative_to(boundary):
+                raise ValueError("Archive entry resolves outside the extraction directory")
+    return relative
