+"""Fixed-format Windows decoder; Python owns names and writable file handles."""
+import ctypes
+from functools import lru_cache
+import hashlib
+import json
+from pathlib import Path
+from uuid import uuid4
+
+from unblob.models import Extractor, ExtractResult
+from unblob.report import ExtractionProblem, UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+from unblob.windows_stream_extractors import MAX_OUTPUT_BYTES
+
+FORMATS = {"arj": "Arj", "cramfs": "CramFS", "dmg": "Dmg", "extfs": "Ext",
+           "fat": "FAT", "ntfs": "NTFS", "msi": "Compound", "squashfs": "SquashFS"}
+RESULTS = {0: "OK", 1: "unsupported method", 2: "data error", 3: "CRC error",
+           4: "unavailable", 5: "unexpected end", 6: "data after end", 7: "not an archive",
+           8: "headers error", 9: "wrong password", -1: "decoder did not confirm completion"}
+
+
+@lru_cache(maxsize=1)
+def _library():
+    directory = Path(__file__).parent / "_windows_native"
+    engine = ctypes.WinDLL(str(directory / "7z.dll"), winmode=0x100 | 0x800)
+    bridge = ctypes.CDLL(str(directory / "rea-sevenzip.dll"), winmode=0x100 | 0x800)
+    pointer, u32, u64, i32 = ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint64, ctypes.c_int32
+    p32, p64 = ctypes.POINTER(u32), ctypes.POINTER(u64)
