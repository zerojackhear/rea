+"""Export verified UBI mappings as ordinary files, retaining source identities."""
+import hashlib
+import json
+
+from unblob.models import Extractor, ExtractResult
+from unblob.report import UnknownError
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+
+class WindowsUbiExtractor(Extractor):
+    def extract(self, inpath, outdir):
+        from ubireader.ubi.readonly import read_volumes
+        reports = []
+        try:
+            total = 0
+            mapping = []
+            with inpath.open("rb") as source:
+                peb, image_sequence, volumes = read_volumes(source, inpath.stat().st_size)
+                for volume in volumes:
+                    expected = sum(block.length for block in volume.blocks)
+                    if expected > MAX_OUTPUT_BYTES - 1024 * 1024 - total:
+                        raise ValueError("UBI observed volume bytes exceed the output bound")
+                    name = f"volume-{volume.number}.image"
+                    digest = hashlib.sha256()
+                    with (outdir / name).open("xb") as output:
+                        for block in volume.blocks:
+                            source.seek(block.position)
+                            remaining = block.length
+                            while remaining:
+                                data = source.read(min(CHUNK_BYTES, remaining))
+                                if not data:
+                                    raise EOFError("UBI source became truncated")
+                                output.write(data); digest.update(data)
+                                remaining -= len(data); total += len(data)
+                    table = volume.table
+                    mapping.append({"volume_id": volume.number, "source_name_bytes": table.name.hex(),
+                        "exported_name": name, "type": "static" if table.vol_type == 2 else "dynamic",
+                        "reserved_pebs": table.reserved_pebs, "observed_lebs": len(volume.blocks),
+                        "bytes": expected, "sha256": digest.hexdigest(),
+                        "source_pebs": [block.source_peb for block in volume.blocks],
+                        "source_sequences": [block.vid.sqnum for block in volume.blocks],
+                        "extent": "observed contiguous logical blocks; unallocated reserved tail is not materialized"})
+            record = json.dumps({"schemaVersion": 1, "physical_block_size": peb,
+                "image_sequence": image_sequence, "volumes": mapping}, indent=2).encode("utf-8")
+            if len(record) > 1024 * 1024:
+                raise ValueError("UBI mapping metadata exceeds its 1 MiB bound")
+            with (outdir / "ubi-volume-map.json").open("xb") as metadata:
+                metadata.write(record)
+        except Exception as error:
+            reports.append(UnknownError(exception=error))
+        return ExtractResult(reports=reports)
