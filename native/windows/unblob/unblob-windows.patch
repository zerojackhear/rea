+            if len(reports) >= 128:
+                raise ValueError("UBIFS diagnostic bound reached; remaining coverage is unknown")
+            reports.append(ExtractionProblem(path=coordinate, problem=str(error),
+                resolution="Committed-tree evidence retained; no repair or host filesystem metadata applied."))
+        try:
