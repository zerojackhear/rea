+"""Materialize Android sparse data with the handler's parsed format facts."""
+import binascii
+import json
+import struct
+
+from unblob.models import Extractor, ExtractResult
+from unblob.report import UnknownError
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+MAP_BUDGET = 4 * 1024 * 1024
+
+
+class WindowsSparseExtractor(Extractor):
+    def extract(self, inpath, outdir):
+        from unblob.handlers.filesystem.android.sparse import SparseHandler
+        reports, unknown_ranges = [], []
+        complete = False
+        try:
+            with inpath.open("rb") as source:
+                header, chunks = SparseHandler().read_layout(source)
+                expected = header.total_blks * header.blk_sz
+                if expected > MAX_OUTPUT_BYTES-MAP_BUDGET:
+                    raise ValueError("Sparse expansion exceeds the output bound including its mapping")
+
+                def read_exact(amount):
+                    value = source.read(amount)
+                    if len(value) != amount:
+                        raise EOFError("Truncated Android sparse chunk")
+                    return value
+
+                crc = total = 0
+                with (outdir / "raw.image").open("xb") as output:
+                    def write(data):
+                        nonlocal crc, total
+                        if len(data) > expected-total:
+                            raise ValueError("Sparse chunks exceed the declared output extent")
+                        output.write(data)
+                        crc = binascii.crc32(data, crc)
+                        total += len(data)
+
+                    for chunk in chunks:
+                        if chunk.chunk_type == 0xCAC1:
+                            remaining = chunk.output_size
+                            while remaining:
+                                data = read_exact(min(CHUNK_BYTES, remaining))
+                                write(data)
+                                remaining -= len(data)
+                        elif chunk.chunk_type in (0xCAC2, 0xCAC3):
+                            if chunk.chunk_type == 0xCAC3 and chunk.output_size:
+                                if len(unknown_ranges) >= 10000:
+                                    raise ValueError("Sparse mapping exceeds its 10000-range bound")
+                                unknown_ranges.append({"source_chunk_offset": chunk.data_offset-header.chunk_hdr_sz,
+                                    "output_offset": chunk.output_offset, "bytes": chunk.output_size})
+                            pattern = read_exact(4) if chunk.chunk_type == 0xCAC2 else b"\0" * 4
+                            block = pattern * (CHUNK_BYTES // 4)
+                            remaining = chunk.output_size
+                            while remaining:
+                                amount = min(CHUNK_BYTES, remaining)
+                                write(block[:amount])
+                                remaining -= amount
+                        elif struct.unpack("<I", read_exact(4))[0] != crc:
+                            raise ValueError("Android sparse chunk CRC32 mismatch")
+                    if header.image_checksum and header.image_checksum != crc:
+                        raise ValueError("Android sparse image CRC32 mismatch")
+                complete = True
+        except Exception as error:
+            reports.append(UnknownError(exception=error))
+        if unknown_ranges:
+            mapping = {"schemaVersion": 1, "source_format": "android-sparse",
+                "output_file": "raw.image", "materialization_complete": complete,
+                "source_content": "DONT_CARE ranges are unspecified by the source image.",
+                "output_representation": "DONT_CARE ranges are zero-filled, including CRC calculation; this does not establish original bytes.",
+                "unknown_ranges": unknown_ranges}
+            encoded = json.dumps(mapping, indent=2).encode("utf-8")
+            if len(encoded) > MAP_BUDGET:
+                reports.append(UnknownError(exception=ValueError("Sparse mapping serialization exceeded its bound")))
+            else:
+                (outdir / "sparse-map.json").write_bytes(encoded)
+        return ExtractResult(reports=reports)
