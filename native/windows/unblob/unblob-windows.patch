+"""Require the native parent-established boundary; never fall back unsandboxed."""
+import ctypes
+from ctypes import wintypes
+
+
+def require_native_sandbox():
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    security = ctypes.WinDLL("advapi32", use_last_error=True)
+    kernel.GetCurrentProcess.restype = wintypes.HANDLE
+    kernel.CloseHandle.argtypes = [wintypes.HANDLE]
+    security.OpenProcessToken.argtypes = [wintypes.HANDLE, wintypes.DWORD, ctypes.POINTER(wintypes.HANDLE)]
+    security.GetTokenInformation.argtypes = [wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(wintypes.DWORD)]
+    kernel.GetProcessMitigationPolicy.argtypes = [wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, ctypes.c_size_t]
+    kernel.IsProcessInJob.argtypes = [wintypes.HANDLE, wintypes.HANDLE, ctypes.POINTER(wintypes.BOOL)]
+    process = kernel.GetCurrentProcess()
+    token = wintypes.HANDLE()
+    if not security.OpenProcessToken(process, 0x0008, ctypes.byref(token)):
+        raise ctypes.WinError(ctypes.get_last_error())
+    try:
+        container, size = wintypes.DWORD(), wintypes.DWORD()
+        if not security.GetTokenInformation(token, 29, ctypes.byref(container), ctypes.sizeof(container), ctypes.byref(size)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if container.value != 1:
+            raise PermissionError("Windows extraction requires the native AppContainer launcher")
+        security.GetTokenInformation(token, 30, None, 0, ctypes.byref(size))
+        if ctypes.get_last_error() != 122 or size.value < ctypes.sizeof(wintypes.DWORD):
+            raise PermissionError("Cannot verify the AppContainer capability list")
+        capabilities = ctypes.create_string_buffer(size.value)
+        if not security.GetTokenInformation(token, 30, capabilities, size, ctypes.byref(size)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if wintypes.DWORD.from_buffer(capabilities).value != 0:
+            raise PermissionError("The extraction worker must have zero capabilities")
+        policy = wintypes.DWORD()
+        if not kernel.GetProcessMitigationPolicy(process, 13, ctypes.byref(policy), ctypes.sizeof(policy)):
+            raise ctypes.WinError(ctypes.get_last_error())
+        if policy.value & 1 != 1:
+            raise PermissionError("Unbrokered child processes must be prohibited")
+        in_job = wintypes.BOOL()
+        if not kernel.IsProcessInJob(process, None, ctypes.byref(in_job)) or not in_job.value:
+            raise PermissionError("The extraction worker must be bound to a native Job Object")
+    finally:
+        kernel.CloseHandle(token)
