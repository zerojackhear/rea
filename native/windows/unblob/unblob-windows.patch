+"""Read-only JFFS2 recovery using the handler-owned structures and CRC rules."""
+from bisect import bisect_left, bisect_right
+from collections import defaultdict, deque
+from dataclasses import dataclass
+import stat
+
+from unblob.models import Extractor, ExtractResult
+from unblob.file_utils import read_until_past
+from unblob.report import ExtractionProblem, UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+from unblob.windows_flash_codecs import decode_flash_node
+from unblob.windows_stream_extractors import MAX_OUTPUT_BYTES
+
+MAX_NODES = 100_000
+MAX_ENTRIES = 10_000
+CODECS = {0: "none", 1: "zero", 2: "rtime", 4: "none", 6: "zlib",
+          7: "lzo", 8: "lzma", 0x15: "lzma-no-size"}
+
+
+@dataclass
+class Inode:
+    header: object
+    source_offset: int
+    encoded: bytes
+
+
+def _fragments(nodes):
+    """Replay admitted versions, retaining source ownership for every byte."""
+    segments = []
+    for node in nodes:
+        inode = node.header
+        # A later inode version can truncate the preceding file state.
+        end = bisect_left(segments, inode.isize, key=lambda item: item[0])
+        del segments[end:]
+        if segments and segments[-1][1] > inode.isize:
+            start, _, old = segments[-1]
+            segments[-1] = (start, inode.isize, old)
+        if inode.dsize == 0:
+            continue
+        start, stop = inode.offset, inode.offset + inode.dsize
+        first = max(0, bisect_right(segments, start, key=lambda item: item[0]) - 1)
+        if first < len(segments) and segments[first][1] <= start:
+            first += 1
+        last = bisect_left(segments, stop, key=lambda item: item[0])
+        replacement = []
+        if first < len(segments) and segments[first][0] < start:
+            a, _, old = segments[first]
+            replacement.append((a, start, old))
+        replacement.append((start, stop, node))
+        if last and last > first and segments[last - 1][1] > stop:
+            _, b, old = segments[last - 1]
+            replacement.append((stop, b, old))
+        segments[first:last] = replacement
+    cursor = 0
+    for start, stop, _ in segments:
+        if start != cursor:
+            raise ValueError("JFFS2 content has an unproven gap; no zero-fill repair was applied")
+        cursor = stop
+    if cursor != nodes[-1].header.isize:
+        raise ValueError("JFFS2 content is incomplete; no zero-fill repair was applied")
+    return segments
+
+
+class WindowsJffs2Extractor(Extractor):
+    def extract(self, inpath, outdir):
+        # The format handler owns endianness, node layouts and CRC semantics.
+        from unblob.handlers.filesystem.jffs2 import (
+            JFFS2NewHandler, JFFS2OldHandler, JFFS2_NODE_ACCURATE,
+            DIRENT, INODE, CLEANMARKER, PADDING, SUMMARY, XATTR, XREF, mtd_crc,
+        )
+        reports = []
+
+        def problem(coordinate, reason):
+            if len(reports) >= 128:
+                raise ValueError("JFFS2 diagnostic limit reached; remaining coverage is unknown")
+            reports.append(ExtractionProblem(path=coordinate, problem=str(reason),
+                resolution="Uncertain content was not repaired; verified output and original input retained."))
+
+        try:
+            inodes = defaultdict(dict)
+            dirents = {}
+            tainted = set()
+            identity_unknown = False
+            with inpath.open("rb") as source:
+                magic = source.read(2)
+                handler = JFFS2OldHandler() if magic in (b"\x84\x19", b"\x19\x84") else JFFS2NewHandler()
+                source.seek(0)
+                endian = handler.guess_endian(source)
+                parser = handler.cparser_be if endian.value == ">" else handler.cparser_le
+                size = inpath.stat().st_size
+                offset = count = 0
+                while offset < size:
+                    if count >= MAX_NODES:
+                        raise ValueError("JFFS2 node inventory exceeds its 100000-node bound")
+                    source.seek(offset)
+                    raw_header = source.read(12)
+                    if raw_header[:4] in (b"\0" * 4, b"\xff" * 4):
