+                        offset = read_until_past(source, b"\0\xff")
+                        if offset < size and offset % 4:
+                            raise ValueError("Unaligned JFFS2 node follows padding")
+                        continue
+                    if len(raw_header) != 12:
+                        raise EOFError("Truncated JFFS2 node header")
+                    header = handler.parse_header(raw_header, endian=endian)
+                    if header.magic not in (0x1984, 0x1985) or not 12 <= header.totlen <= size - offset:
+                        raise ValueError(f"Invalid JFFS2 node extent at input offset {offset}")
+                    normalized = bytearray(raw_header)
