+"""Read EROFS through a fixed handle-only native library in the Windows worker."""
+import ctypes
+from functools import lru_cache
+from pathlib import Path
+import stat
+
+from unblob.models import Extractor, ExtractResult
+from unblob.report import ExtractionProblem, UnknownError
+from unblob.windows_archive_paths import checked_windows_archive_path
+from unblob.windows_stream_extractors import CHUNK_BYTES, MAX_OUTPUT_BYTES
+
+
+@lru_cache(maxsize=1)
+def _library():
+    dll = ctypes.CDLL(str(Path(__file__).parent / "_windows_native/rea-erofs.dll"), winmode=0x100 | 0x800)
+    ptr, u32, u64, integer = ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint64, ctypes.c_int
+    signatures = {
+        "reaer_open": [ptr, ctypes.POINTER(ptr)],
+        "reaer_close": [ptr],
+        "reaer_count": [ptr, ctypes.POINTER(u32), ctypes.POINTER(u32), ctypes.POINTER(integer)],
+        "reaer_item": [ptr, u32, ptr, u32, ctypes.POINTER(u32), ctypes.POINTER(u32),
+                       ctypes.POINTER(u32), ctypes.POINTER(u64), ctypes.POINTER(u32), ctypes.POINTER(integer)],
+        "reaer_read": [ptr, u32, u64, ptr, u32],
+    }
+    for name, arguments in signatures.items():
+        method = getattr(dll, name); method.argtypes = arguments; method.restype = integer
+    return dll
+
+
+def _checked(status, action):
+    if status:
+        raise ValueError(f"Native EROFS {action} failed (errno {abs(status)})")
+
+
+class WindowsErofsExtractor(Extractor):
+    def extract(self, inpath, outdir):
+        import msvcrt
+        reports = []
+
+        def problem(path, error):
+            if len(reports) >= 128:
+                raise ValueError("EROFS diagnostic bound reached; remaining coverage is unknown")
+            reports.append(ExtractionProblem(path=path, problem=str(error),
+                resolution="Verified content retained; no repair, host links, mount or permission changes applied."))
+        try:
+            dll = _library(); session = ctypes.c_void_p()
+            with inpath.open("rb") as source:
+                _checked(dll.reaer_open(msvcrt.get_osfhandle(source.fileno()), ctypes.byref(session)), "open/checksum")
+                try:
+                    count, errors, last_error = ctypes.c_uint32(), ctypes.c_uint32(), ctypes.c_int()
+                    _checked(dll.reaer_count(session, ctypes.byref(count), ctypes.byref(errors), ctypes.byref(last_error)), "inventory")
+                    if not 1 <= count.value <= 10000:
+                        raise ValueError("EROFS native inventory exceeds its declared bound")
+                    if errors.value:
+                        problem("<EROFS directory inventory>", f"{errors.value} directory reads were incomplete (last errno {abs(last_error.value)})")
+                    paths = {0: ()}
+                    buffer = ctypes.create_string_buffer(CHUNK_BYTES)
+                    total = 0
+                    for index in range(1, count.value):
+                        coordinate = f"<EROFS entry index {index}; name unknown>"
+                        try:
+                            name = ctypes.create_string_buffer(256)
+                            length, parent, mode, xattrs = (ctypes.c_uint32() for _ in range(4))
+                            size, status = ctypes.c_uint64(), ctypes.c_int()
+                            _checked(dll.reaer_item(session, index, name, len(name), ctypes.byref(length),
+                                ctypes.byref(parent), ctypes.byref(mode), ctypes.byref(size),
+                                ctypes.byref(xattrs), ctypes.byref(status)), "metadata")
+                            raw = name.raw[:length.value]
+                            coordinate = f"<EROFS entry {index}, parent {parent.value}, name bytes {raw.hex()}>"
+                            component = raw.decode("utf-8", "strict")
+                            if parent.value not in paths or parent.value >= index:
+                                raise ValueError("EROFS parent path was not admitted")
+                            if component in ("", ".", "..") or "/" in component or "\0" in component:
+                                raise ValueError("Invalid EROFS directory component")
+                            parts = (*paths[parent.value], component)
+                            coordinate = "/".join(parts)
+                            target = outdir / checked_windows_archive_path(outdir, coordinate, posix_source=True)
+                            if stat.S_ISDIR(mode.value):
+                                target.mkdir(parents=True, exist_ok=True); paths[index] = parts
+                                continue
+                            if not stat.S_ISREG(mode.value):
+                                raise ValueError("EROFS link or special inode was not materialized")
+                            if size.value > MAX_OUTPUT_BYTES - total:
+                                raise ValueError("EROFS file exceeds the 512 MiB output bound")
+                            target.parent.mkdir(parents=True, exist_ok=True)
+                            with target.open("xb") as output:
+                                offset = 0
+                                while offset < size.value:
+                                    amount = min(CHUNK_BYTES, size.value - offset)
+                                    _checked(dll.reaer_read(session, index, offset, buffer, amount), "content read")
+                                    output.write(buffer.raw[:amount]); offset += amount; total += amount
+                        except (ValueError, OSError, UnicodeError, EOFError) as error:
+                            problem(coordinate, error)
+                finally:
+                    if session.value:
+                        status = dll.reaer_close(session); session.value = None
+                        _checked(status, "close")
+        except Exception as error:
+            reports.append(UnknownError(exception=error))
+        return ExtractResult(reports=reports)
