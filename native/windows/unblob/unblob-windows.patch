+    lib = ctypes.CDLL(str(Path(__file__).parent/'_windows_native/rea-xad.dll'), winmode=0x100|0x800)
+    ptr, uint, integer, u64 = ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_uint64
+    signatures = {
+        'reaxad_open': [ptr,uint,ctypes.POINTER(ptr)],
+        'reaxad_close': [ptr],
+        'reaxad_count': [ptr,ctypes.POINTER(uint),ctypes.POINTER(integer)],
+        'reaxad_item': [ptr,uint,ptr,uint,ctypes.POINTER(uint),ctypes.POINTER(u64),ctypes.POINTER(uint)],
+        'reaxad_begin': [ptr,uint,ctypes.POINTER(uint)],
+        'reaxad_read': [ptr,ptr,uint],
+        'reaxad_error': [ptr,ptr,uint],
+    }
+    for name, arguments in signatures.items():
+        method = getattr(lib,name); method.argtypes=arguments; method.restype=integer
+    return lib
